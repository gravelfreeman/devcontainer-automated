#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_NAME="$(basename "$0")"
TEMPLATE_REPO="https://github.com/gravelfreeman/devcontainer-automated.git"
WORKSPACE_DIR="$(pwd -P)"
CONTAINER_LABEL=""
CONTAINER_SHELL="zsh"
LOG_LEVEL=info
COMMAND=run

log() {
    local level=info levels=" debug info warning error "

    case "${1:-}" in debug | info | warning | error) level="$1"; shift ;; esac
    [[ "${levels}" == *" ${level} "* ]] || LOG_LEVEL=info
    [[ "${level}" == debug && "${LOG_LEVEL}" != debug ]] && return 0
    printf '[%s] %s\n' "${level}" "$*" >&2
}

usage() {
    cat <<EOF
Usage: ${SCRIPT_NAME} [options] [command]

Commands:
  init     Initialize the current project with the default .devcontainer template
  up       Create or start a devcontainer
  rebuild  Recreate a devcontainer, then open a shell
  shell    Open a shell in the running devcontainer

Options:
  --help             Show this help message
  --workspace <path> Use a workspace path instead of the current directory
  --debug            Enable debug logs
EOF
}

usage_error() {
    log error "$1"
    printf '\n' >&2
    usage >&2
    exit 1
}

set_workspace() {
    local requested_dir="$1"

    [[ -d "${requested_dir}" ]] || {
        log error "Workspace directory not found: ${requested_dir}"
        exit 1
    }

    WORKSPACE_DIR="$(cd "${requested_dir}" && pwd -P)"
    CONTAINER_LABEL="devcontainer.local_folder=${WORKSPACE_DIR}"
}

project_name() {
    basename "${WORKSPACE_DIR}"
}

require_workspace_config() {
    [[ -d "${WORKSPACE_DIR}/.devcontainer" ]] || {
        log error "${WORKSPACE_DIR} has no .devcontainer directory. Run '${SCRIPT_NAME} init' first."
        exit 1
    }
}

init_workspace() {
    local project temp_dir template_dir
    project="$(project_name)"

    [[ ! -e "${WORKSPACE_DIR}/.devcontainer" ]] || {
        log warning "${project} already has a .devcontainer"
        exit 1
    }

    log "Initializing ${project}"
    temp_dir="$(mktemp -d "${TMPDIR:-/tmp}/devcontainer-automated.XXXXXX")"

    if ! git clone --depth 1 --quiet "${TEMPLATE_REPO}" "${temp_dir}/repository"; then
        rm -rf "${temp_dir}"
        log error "Failed to download the devcontainer template"
        exit 1
    fi

    template_dir="${temp_dir}/repository/.devcontainer"
    if [[ ! -d "${template_dir}" ]]; then
        rm -rf "${temp_dir}"
        log error "The remote repository does not contain a .devcontainer template"
        exit 1
    fi

    if ! cp -R "${template_dir}" "${WORKSPACE_DIR}/"; then
        rm -rf "${temp_dir}"
        log error "Failed to copy .devcontainer into ${project}"
        exit 1
    fi

    rm -rf "${temp_dir}"
    log "Success: ${project} is initialized"
}

check_dependencies() {
    local missing=() command_name

    for command_name in "$@"; do
        command -v "${command_name}" >/dev/null 2>&1 || missing+=("${command_name}")
    done

    ((${#missing[@]} == 0)) || {
        log error "Missing required command(s): ${missing[*]}"
        exit 1
    }
}

check_host_setup() {
    [[ -S "${HOME}/.1password/agent.sock" ]] || {
        log error "1Password SSH agent socket not found: ${HOME}/.1password/agent.sock"
        log error "Start the 1Password desktop app and enable its SSH agent."
        exit 1
    }

    [[ -f "${HOME}/.gitconfig" ]] || {
        log error "Git config not found: ${HOME}/.gitconfig"
        exit 1
    }

    install -d -m 0755 "${HOME}/.local/state"

    [[ -x /usr/bin/op ]] || {
        log error "1Password CLI not found at /usr/bin/op"
        exit 1
    }

    [[ -x /usr/bin/opencode ]] || {
        log error "OpenCode not found at /usr/bin/opencode"
        exit 1
    }
}

container_id() {
    if [[ "${1:-all}" == running ]]; then
        docker ps -q --filter "label=${CONTAINER_LABEL}" | head -n1
        return 0
    fi

    docker ps -aq --filter "label=${CONTAINER_LABEL}" | head -n1
}

remove_container() {
    local ids

    ids="$(docker ps -aq --filter "label=${CONTAINER_LABEL}")"
    [[ -z "${ids}" ]] && return 0

    log "Removing existing devcontainer"
    printf '%s\n' "${ids}" | xargs -r docker rm -f >/dev/null
}

devcontainer_up() {
    log_preview devcontainer up --no-lockfile
}

prepare_container() {
    local force="$1"
    local cid running_cid

    cid="$(container_id)"
    running_cid="$(container_id running)"
    log debug "Container state cid=${cid:-<empty>} running_cid=${running_cid:-<empty>} force=${force}"

    if [[ "${force}" == true ]]; then
        remove_container
        cid=
        running_cid=
    fi

    if [[ -z "${cid}" ]]; then
        log "Creating devcontainer"
        devcontainer_up || { log error "Failed to create devcontainer"; exit 1; }
        return 0
    fi

    if [[ -z "${running_cid}" ]]; then
        log "Starting existing devcontainer"
        devcontainer_up || { log error "Failed to start devcontainer"; exit 1; }
    fi

}

open_shell() {
    local cid

    cid="$(container_id running)"
    [[ -n "${cid}" ]] || { log error "No running devcontainer found for ${WORKSPACE_DIR}"; exit 1; }
    clear

    exec devcontainer exec --workspace-folder "${WORKSPACE_DIR}" \
        "${CONTAINER_SHELL}" -lc 'clear; exec "$0" -il' "${CONTAINER_SHELL}"
}

run_flow() {
    local force="$1"
    local open_terminal="$2"

    check_dependencies devcontainer docker
    check_host_setup
    require_workspace_config
    prepare_container "${force}"
    [[ "${open_terminal}" == true ]] && open_shell
}

run_shell_flow() {
    local running_cid

    check_dependencies devcontainer docker
    check_host_setup
    running_cid="$(container_id running)"

    if [[ -n "${running_cid}" ]]; then
        open_shell
        return 0
    fi

    require_workspace_config
    prepare_container false
    open_shell
}

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --workspace)
                shift
                [[ $# -gt 0 ]] || usage_error "Missing value for --workspace"
                WORKSPACE_DIR="$1"
                ;;
            --debug)
                LOG_LEVEL=debug
                ;;
            --help)
                COMMAND=help
                return 0
                ;;
            init | up | rebuild | shell)
                COMMAND="$1"
                ;;
            *)
                usage_error "Unknown argument: $1"
                ;;
        esac
        shift
    done
}

main() {
    parse_args "$@"
    [[ "${COMMAND}" == help ]] && { usage; return 0; }
    [[ "$(uname -s)" == Linux ]] || {
        log error "${SCRIPT_NAME} supports Linux only"
        exit 1
    }

    set_workspace "${WORKSPACE_DIR}"
    log debug "Workspace=${WORKSPACE_DIR} command=${COMMAND} shell=${CONTAINER_SHELL}"

    case "${COMMAND}" in
        init)
            check_dependencies cp git mktemp rm
            init_workspace
            ;;
        run)
            run_flow false true
            ;;
        up)
            run_flow false false
            ;;
        rebuild)
            run_flow true true
            ;;
        shell)
            run_shell_flow
            ;;
        *)
            usage_error "Unknown command: ${COMMAND}"
            ;;
    esac
}

log_preview() {
    local log_file pid width line state move_up
    local shown=0
    local previous_state=
    local line_limit=10
    local color='\033[38;5;245m'
    local cursor_hidden=false

    preview_state() {
        tail -n "${line_limit}" "${log_file}" 2>/dev/null \
            | sed -E 's/^\[[0-9]{4}-[0-9]{2}-[0-9]{2}T[^]]+\][[:space:]]*//'
    }

    render_preview() {
        if ((shown > 0)); then
            move_up="$(tput cuu "${shown}" 2>/dev/null || printf '\033[%sA' "${shown}")"
            printf '%s' "${move_up}"
        fi

        shown=0
        while IFS= read -r line; do
            ((shown++))
            printf '\033[2K'
            (( ${#line} >= width )) && line="${line:0:width-1}..."
            printf '%b%s\033[0m\n' "${color}" "${line}"
        done <<<"${1}"
    }

    finish_preview() {
        [[ "${cursor_hidden}" == true ]] && printf '\033[?25h'
        cursor_hidden=false
        [[ "${1:-keep}" == delete && -n "${log_file:-}" ]] && rm -f "${log_file}"
    }

    log_file="$(mktemp)"
    : >"${log_file}"
    "$@" >"${log_file}" 2>&1 &
    pid=$!

    trap '[[ -n "${pid:-}" ]] && kill "${pid}" >/dev/null 2>&1 || true; finish_preview delete; trap - INT TERM; exit 130' INT TERM
    printf '\033[?25l'
    cursor_hidden=true
    width="${COLUMNS:-$(tput cols 2>/dev/null || printf '120')}"
    ((width > 8)) || width=120

    while kill -0 "${pid}" >/dev/null 2>&1; do
        state="$(preview_state)"
        if [[ -n "${state}" && "${state}" != "${previous_state}" ]]; then
            render_preview "${state}"
            previous_state="${state}"
        fi
        sleep 0.2
    done

    wait "${pid}" || {
        trap - INT TERM
        finish_preview
        cat "${log_file}" >&2
        rm -f "${log_file}"
        return 1
    }

    state="$(preview_state)"
    if [[ -n "${state}" && "${state}" != "${previous_state}" ]]; then
        render_preview "${state}"
    fi

    trap - INT TERM
    finish_preview delete
}

main "$@"
